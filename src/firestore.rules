/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * For prototyping purposes, these rules have been simplified to allow any authenticated
 * user to perform read and write operations across the database. This is NOT suitable
 * for a production environment but ensures the prototype is fully functional without
 * being blocked by restrictive security policies.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to all documents in the database.
     * @path /{document=**}
     * @allow (read, write) Any authenticated user can read or write any data.
     * @principle Open access for any authenticated user for prototyping.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
