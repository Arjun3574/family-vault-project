rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    match /userProfiles/{userId} {
      // A user can create their own profile upon signup.
      allow create: if request.auth.uid == userId;
      
      // A user can read their own profile, or the profile of another user in the same family.
      allow read: if request.auth.uid == userId || 
                  (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.familyId != null &&
                   get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.familyId == get(/databases/$(database)/documents/userProfiles/$(userId)).data.familyId);

      // A user can only update their own profile.
      allow update: if request.auth.uid == userId;
    }
    
    match /families/{familyId} {
      // Any authenticated user can create a family.
      allow create: if request.auth != null;
      
      // To read a family doc, you must be a member.
      allow read: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.familyId == familyId;
      
      // Only the 'owner' of the family can update its details.
      allow update: if request.auth != null && resource.data.owner == request.auth.uid;
      
      // Only the owner can delete the family.
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    match /families/{familyId}/photos/{photoId} {
      // Reads are allowed for authenticated users who are part of the family.
      allow read: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.familyId == familyId;

      // Writes are allowed if an authenticated user is in the family, OR if the write is from our trusted server.
      // We trust the server if the request is unauthenticated (auth == null) but contains the necessary data fields.
      allow write: if (request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.familyId == familyId) 
                   || (request.auth == null && request.resource.data.userId != null && request.resource.data.familyId != null);
    }
    
    // Rules for special days reverted to use get() for compatibility without Cloud Functions.
    match /families/{familyId}/specialDays/{specialDayId} {
       allow read, write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.familyId == familyId;
    }
    
    match /tags/{tagId} {
        // Any authenticated user can manage tags.
        allow read, write: if request.auth != null;
    }
  }
}
