rules_version = '2';

// 1. Only authenticated users can read or write to storage.
// 2. Users can only write to a path that matches their familyId and userId.
// 3. The uploaded file must be an image and less than 10MB.
service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the photos directory
    match /photos/{familyId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
