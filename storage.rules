rules_version = '2';

/**
 * @fileoverview Firebase Storage Security Rules for the application.
 *
 * For prototyping purposes, these rules allow any authenticated user to upload
 * any file. This is NOT suitable for a production environment but ensures that
 * the photo upload functionality works without permission errors.
 */
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read and write access to any path for any authenticated user.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
