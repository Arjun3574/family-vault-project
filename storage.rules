rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Users can only read/write to their own family's photo folder.
    // Their profile in Firestore must contain a matching familyId.
    match /families/{familyId}/photos/{allPaths=**} {
      allow read: if request.auth != null && get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.familyId == familyId;
      allow write: if request.auth != null && get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.familyId == familyId;
    }
  }
}
