rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Users can only upload photos to their own family's folder.
    // The path must match /photos/{familyId}/{fileName}
    // The user's own profile document in Firestore must contain the matching familyId.
    match /photos/{familyId}/{fileName} {
      allow read, write: if request.auth != null 
          && get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.familyId == familyId;
    }
    
    // Allow read for any other path, for things like public assets.
    match /{allPaths=**} {
      allow read: if true;
    }
  }
}
