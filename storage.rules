rules_version = '2';

// 1. Only authenticated users can read or write to storage.
// 2. The uploaded file must be an image and less than 10MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
